{
  "data_path": "./data/train.csv",
  "output_dir": "./model/lgbm",
  "top_k": 5,
  "n_splits": 4,
  "gap_days": 5,
  "val_days": 20,
  "final_rounds": 500,
  "lgbm_params": {
    "objective": "regression",
    "metric": "rmse",
    "learning_rate": 0.03,
    "num_leaves": 63,
    "min_child_samples": 30,
    "subsample": 0.8,
    "subsample_freq": 1,
    "colsample_bytree": 0.7,
    "reg_alpha": 0.05,
    "reg_lambda": 0.1,
    "min_split_gain": 0.01,
    "random_state": 42,
    "n_jobs": 4,
    "verbose": -1
  }
}